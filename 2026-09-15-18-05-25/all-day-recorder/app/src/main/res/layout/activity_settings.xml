<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WebDAV 上传设置（PikPak）"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="地址" android:textSize="14sp" />
        <EditText android:id="@+id/etUrl"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textUri" android:hint="https://dav.mypikpak.com" android:textSize="14sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="用户名" android:textSize="14sp" />
        <EditText android:id="@+id/etUser"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text" android:textSize="14sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="密码" android:textSize="14sp" />
        <EditText android:id="@+id/etPass"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textPassword" android:textSize="14sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="上传目录（如 watch-recordings）" android:textSize="14sp" />
        <EditText android:id="@+id/etFolder"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text" android:hint="watch-recordings" android:textSize="14sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="行为选项" android:textSize="16sp" android:textStyle="bold"
            android:paddingTop="12dp" android:paddingBottom="6dp" />

        <CheckBox android:id="@+id/cbAutoStart"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="开机自动开始录音" android:textSize="15sp" />
        <CheckBox android:id="@+id/cbAutoUpload"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="充电时自动上传" android:textSize="15sp" />
        <CheckBox android:id="@+id/cbWifiOnly"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="仅 WiFi 上传（省流量）" android:textSize="15sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="录音音质" android:textSize="15sp" android:textStyle="bold"
            android:paddingTop="8dp" />
        <RadioGroup android:id="@+id/rgQuality"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton android:id="@+id/rbQualityLow"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="省电省空间（约 0.5MB/分，推荐）" android:textSize="14sp" />
            <RadioButton android:id="@+id/rbQualityHigh"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="高音质（文件更大）" android:textSize="14sp" />
        </RadioGroup>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="每段时长" android:textSize="15sp" android:textStyle="bold"
            android:paddingTop="8dp" />
        <RadioGroup android:id="@+id/rgSegment"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton android:id="@+id/rbSeg5"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="5 分钟" android:textSize="14sp" />
            <RadioButton android:id="@+id/rbSeg10"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="10 分钟" android:textSize="14sp" />
            <RadioButton android:id="@+id/rbSeg15"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="15 分钟" android:textSize="14sp" />
            <RadioButton android:id="@+id/rbSeg30"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="30 分钟" android:textSize="14sp" />
        </RadioGroup>

        <Button android:id="@+id/btnBattery"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="44dp" android:text="电池优化白名单（防杀后台）"
            android:textSize="15sp" android:layout_marginTop="12dp" />

        <Button android:id="@+id/btnSave"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="保存"
            android:textSize="18sp" android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
